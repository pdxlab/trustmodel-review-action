{
  "name": "trustmodel-review-action",
  "version": "0.2.0",
  "description": "Metadata-only Trust Review preview. Fails closed until PR diff evaluation is available.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --minify",
    "package": "npm run build",
    "test": "tsc && node --test tests/*.test.cjs && python3 tests/runner.test.py",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "ai",
    "trustscore",
    "governance",
    "llm",
    "eval"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.3.0"
  }
}
